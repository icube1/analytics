# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build
/target
/apps/web/dist
/apps/site/dist
/apps/site/.astro

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
apps/web/.env.example
apps/mobile/.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# персональные данные (хранятся локально в data/ и statements/)
/data/portfolio.json
/data/broker-report.html
/statements/*.csv
/statements/*.CSV
apps/web/node_modules
/ci-reports/
deploy.tar.gz

# capacitor native shells (generated locally; snippets under apps/mobile/native-config/)
/apps/mobile/ios/
/apps/mobile/android/
/apps/mobile/.env.local
**/DerivedData/
**/*.xcworkspace/xcuserdata/
**/*.xcodeproj/xcuserdata/
**/*.ipa
**/*.apk
**/*.aab
**/.gradle/
**/local.properties
