---
const appUrl = "https://app.gala-soft.ru";
---

<header class="site-header">
  <div class="container site-header__inner">
    <a class="site-header__brand" href="/">
      <img src="/favicon.svg" width="32" height="32" alt="" aria-hidden="true" />
      <span>Gala</span>
    </a>
    <nav class="site-header__nav" aria-label="Основная навигация">
      <a href="#layers">Резервы</a>
      <a href="#demo">Демо</a>
      <a href="#privacy">Приватность</a>
      <a class="btn btn--primary site-header__cta" href={appUrl}>
        Открыть приложение
      </a>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    border-bottom: 1px solid var(--border);
    background: color-mix(in srgb, var(--background) 92%, transparent);
    backdrop-filter: blur(8px);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
    padding-block: var(--space-md);
  }

  .site-header__brand {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--foreground);
    font-weight: 700;
    text-decoration: none;
  }

  .site-header__nav {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-md);
  }

  .site-header__nav a:not(.btn) {
    color: var(--muted);
    text-decoration: none;
    font-size: 0.95rem;
  }

  .site-header__nav a:not(.btn):hover {
    color: var(--foreground);
  }

  .site-header__cta {
    font-size: 0.9rem;
    padding: 0.55rem 1rem;
  }

  @media (max-width: 40rem) {
    .site-header__nav a:not(.site-header__cta) {
      display: none;
    }
  }
</style>
