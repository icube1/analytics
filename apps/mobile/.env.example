# Mobile shell (Capacitor) — copy to .env.local for local native builds.
# Never commit .env.local or signing secrets.

# HTTPS API origin injected into the WebView bundle at prepare time.
# Required when the API is not same-origin with the Capacitor virtual host.
# MOBILE_API_BASE=https://app.gala-soft.ru

# Optional overrides for native project metadata.
# CAPACITOR_APP_ID=ru.galasoft.analytics
# CAPACITOR_APP_NAME=Analytics

# Custom URL scheme for OAuth / auth callbacks (must match iOS/Android intent filters).
# MOBILE_AUTH_SCHEME=analytics
