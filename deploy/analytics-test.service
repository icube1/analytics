[Unit]
Description=Analytics dashboard (test.gala-soft.ru)
After=network.target

[Service]
Type=simple
User=analytics
Group=analytics
WorkingDirectory=/opt/analytics-test
EnvironmentFile=-/etc/analytics-auth.env
EnvironmentFile=-/etc/analytics-test.env
Environment=NODE_ENV=production
Environment=PORT=3001
Environment=HOSTNAME=127.0.0.1
Environment=MARKET_CACHE_DIR=/opt/analytics-test/data
Environment=NODE_OPTIONS=--max-old-space-size=160
ExecStart=/usr/bin/node server.js
Restart=on-failure
RestartSec=5
MemoryMax=192M
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/opt/analytics-test/data /opt/analytics-test/statements
CapabilityBoundingSet=
RestrictSUIDSGID=true
LockPersonality=true
RestrictRealtime=true
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
