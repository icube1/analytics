# Metrics dashboard — enable only after PLATFORM_CUTOVER=1 and observability data dir exists.
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name metrics.gala-soft.ru;

    auth_basic "Analytics Metrics";
    auth_basic_user_file /etc/nginx/.htpasswd-analytics;

    ssl_certificate /etc/letsencrypt/live/gala-soft.ru/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/gala-soft.ru/privkey.pem;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;
    ssl_session_cache shared:analytics_SSL:10m;
    ssl_session_timeout 1440m;
    ssl_session_tickets off;
    ssl_protocols TLSv1.2;
    ssl_prefer_server_ciphers off;
    ssl_ciphers "ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:DHE-RSA-AES128-GCM-SHA256:DHE-RSA-AES256-GCM-SHA384:ECDHE-RSA-AES128-SHA";

    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header X-Robots-Tag "noindex, nofollow" always;
    add_header Cache-Control "no-store" always;

    root /opt/analytics-platform/staging/current/metrics-dashboard/dist;
    index index.html;

    location /data/ {
        alias /var/lib/analytics/observability/;
        default_type application/json;
        auth_basic "Analytics Metrics";
        auth_basic_user_file /etc/nginx/.htpasswd-analytics;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
