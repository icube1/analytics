# Astro marketing site — enable only after PLATFORM_CUTOVER=1.
# Public landing: no HTTP Basic. Uses existing gala-soft.ru TLS material.
server {
    listen 80;
    listen [::]:80;
    server_name gala-soft.ru www.gala-soft.ru;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name gala-soft.ru www.gala-soft.ru;
    client_max_body_size 2m;

    ssl_certificate /etc/letsencrypt/live/gala-soft.ru/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/gala-soft.ru/privkey.pem;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;
    ssl_session_cache shared:analytics_SSL:10m;
    ssl_session_timeout 1440m;
    ssl_session_tickets off;
    ssl_protocols TLSv1.2;
    ssl_prefer_server_ciphers off;
    ssl_ciphers "ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:DHE-RSA-AES128-GCM-SHA256:DHE-RSA-AES256-GCM-SHA384:ECDHE-RSA-AES128-SHA";

    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "no-referrer" always;

    root /opt/analytics-platform/staging/current/site/dist;
    index index.html;

    location / {
        try_files $uri $uri/ /index.html;
    }
}
