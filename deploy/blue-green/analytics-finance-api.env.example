# Copy to /etc/analytics-finance-api.env on the server (root:root, mode 600).
# Never commit real secrets. The platform release tarball must not include this file.
#
# Bootstrap (first-run admin; required for loopback auth before external IdP)
# FINANCE_API_BOOTSTRAP_EMAIL=admin@gala-soft.ru
# FINANCE_API_BOOTSTRAP_PASSWORD=<from /etc/analytics-auth.env>
# FINANCE_API_BOOTSTRAP_DISPLAY_NAME=Администратор
# FINANCE_API_BOOTSTRAP_HOUSEHOLD_NAME=Household
#
# Billing / entitlements (test provider in staging; replace for production store)
# FINANCE_API_BILLING_WEBHOOK_SECRET=<generated-on-server>
#
# Session / transport
# FINANCE_API_SESSION_COOKIE_SECURE=1
# FINANCE_API_SESSION_TTL_SECS=604800
#
# SQLite + worker limits (defaults match finance-api.service)
# FINANCE_API_DATA_DIR=/opt/analytics-platform/data
# FINANCE_API_DB_MAX_CONNECTIONS=2
# FINANCE_API_WORKER_CONCURRENCY=1
# FINANCE_API_JOB_TIMEOUT_SECS=120
# FINANCE_API_MAX_PENDING_JOBS_PER_HOUSEHOLD=4
# FINANCE_API_IDEMPOTENCY_TTL_SECS=86400
# FINANCE_API_MAX_REQUEST_BYTES=10485760
#
# Metrics scrape auth (reuse analytics basic auth or OBSERVABILITY_TOKEN)
# ANALYTICS_AUTH_USER=owner
# ANALYTICS_AUTH_PASSWORD=<from /etc/analytics-auth.env>
# OBSERVABILITY_TOKEN=<optional bearer for /internal/metrics>
