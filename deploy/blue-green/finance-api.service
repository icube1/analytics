[Unit]
Description=Finance API (Axum, staging / blue-green)
After=network.target
Wants=network-online.target

[Service]
Type=simple
User=analytics
Group=analytics
WorkingDirectory=/opt/analytics-platform/staging/current
EnvironmentFile=-/etc/analytics-auth.env
EnvironmentFile=-/etc/analytics-finance-api.env
Environment=FINANCE_API_ENV=production
Environment=FINANCE_API_BIND=127.0.0.1:8080
Environment=FINANCE_API_DATA_DIR=/opt/analytics-platform/data
Environment=FINANCE_API_DB_MAX_CONNECTIONS=2
Environment=FINANCE_API_WORKER_CONCURRENCY=1
Environment=RUST_LOG=finance_api=info,tower_http=warn,sqlx=warn
ExecStart=/opt/analytics-platform/staging/current/finance-api/bin/finance-api
Restart=on-failure
RestartSec=5
MemoryMax=192M
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/opt/analytics-platform/data
CapabilityBoundingSet=
RestrictSUIDSGID=true
LockPersonality=true
RestrictRealtime=true
SystemCallArchitectures=native
StandardOutput=journal
StandardError=journal
SyslogIdentifier=finance-api

[Install]
WantedBy=multi-user.target
