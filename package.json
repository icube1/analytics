{
  "name": "analytics",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "next dev",
    "dev:web": "npm run dev --workspace @analytics/web",
    "dev:site": "npm run dev --workspace @analytics/site",
    "build": "next build",
    "build:web": "npm run build --workspace @analytics/web",
    "build:site": "npm run build --workspace @analytics/site",
    "build:standalone": "next build && bash scripts/prepare-standalone.sh",
    "preview:web": "npm run preview --workspace @analytics/web",
    "typecheck:web": "npm run typecheck --workspace @analytics/web",
    "typecheck:site": "npm run typecheck --workspace @analytics/site",
    "test:web": "npm run test --workspace @analytics/web",
    "test:site": "npm run test --workspace @analytics/site",
    "test:site:a11y": "npm run test:a11y --workspace @analytics/site",
    "measure:bundles": "node scripts/measure-bundles.mjs",
    "ci:verify": "bash scripts/ci-verify.sh",
    "package:deploy": "bash scripts/package-deploy.sh",
    "benchmark:finance": "tsx scripts/benchmark-finance.ts",
    "sanitize:broker-fixtures": "tsx scripts/sanitize-broker-fixture.ts",
    "compare:finance-core": "tsx scripts/compare-finance-core.ts",
    "compare:finance-core:resilience": "tsx scripts/compare-finance-core-resilience.ts",
    "build:wasm": "bash scripts/build-finance-wasm.sh",
    "start": "next start",
    "lint": "eslint",
    "test": "jest --runInBand --forceExit",
    "test:watch": "jest --watch --runInBand"
  },
  "dependencies": {
    "linkedom": "^0.18.12",
    "next": "16.2.7",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^3.8.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/jest": "^30.0.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.7",
    "jest": "^30.4.2",
    "tailwindcss": "^4",
    "ts-jest": "^29.4.11",
    "tsx": "^4.23.13",
    "typescript": "^5"
  }
}
